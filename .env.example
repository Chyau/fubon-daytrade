# ============================================
# 富邦新一代 SDK — 測試環境（零風險沙箱，預設）
# ============================================
# SDK 下載：https://www.fbs.com.tw/TradeAPI/docs/download/download-sdk
#
# 測試憑證下載：
#   https://www.fbs.com.tw/TradeAPI_SDK/sample_code/test_environment.zip
#   解壓縮後會得到：
#     - 58581758.pfx（測試憑證，CN=58581758）
#     - 41610792.pfx（另一組測試憑證，CN=41610792）
#     - 新一代API測試環境手冊_0520.pdf
#
# 重要：
#   - 帳號 (FUBON_TEST_ID) = 憑證 CN 值（例如 58581758），不是身分證字號
#   - 密碼 (FUBON_TEST_PASSWORD) = 12345678（富邦官方預設）
#   - 憑證密碼 (FUBON_TEST_CERT_PASSWORD) = 12345678
#   - 測試環境開盤時間：09:30~19:00
#   - 庫存每日重設
FUBON_USE_TEST=1
FUBON_TEST_URL=wss://neoapitest.fbs.com.tw/TASP/XCPXWS
FUBON_TEST_ID=
FUBON_TEST_PASSWORD=
FUBON_TEST_CERT_PATH=
FUBON_TEST_CERT_PASSWORD=

# ============================================
# 富邦新一代 SDK — 正式環境（實單交易）
# ============================================
# ⚠️ 切換到正式環境前請：
#   1. 先在測試環境跑通至少 10 筆交易
#   2. 確認已了解 PLACE_ORDER=true 代表真實下單
#   3. 改 FUBON_USE_TEST=0
#
# 正式憑證申請：
#   https://www.fbs.com.tw/Certificate/Management/
#   下載「富邦證券憑證e總管」(TCEM.exe) → 用帳號登入 → 申請憑證
#   憑證檔名通常為「身分證字號.pfx」（例如 A123456789.pfx）
#
# 重要：
#   - 帳號 (FUBON_LIVE_ID) = 你的身分證字號（大寫，例如 A123456789）
#   - 密碼 (FUBON_LIVE_PASSWORD) = 富邦網路下單密碼
#   - 憑證密碼 (FUBON_LIVE_CERT_PASSWORD) = 申請憑證時設定的密碼
#   - 正式環境整股數量必須是 1000 股的倍數（1 張）
# 真實盤時改成：
# FUBON_USE_TEST=0
FUBON_LIVE_ID=
FUBON_LIVE_PASSWORD=
FUBON_LIVE_CERT_PATH=
FUBON_LIVE_CERT_PASSWORD=

# ============================================
# 下單安全開關（fubon_orders.py）
# ============================================
# false（預設）→ 沒有真實下單，只輸出富邦新一代API下單參數（dry-run）
# true         → 真實下單（還需 --send；正式環境另需 --yes + 輸入代號確認）
PLACE_ORDER=false

# ============================================
# Telegram Bot（推播 + 遠端控制）
# ============================================
# 建立 Bot：找 @BotFather → /newbot → 取得 Bot Token
# 取得 Chat ID：找 @userinfobot → 取得您的 Chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REMOTE_CONTROL=true

# ============================================
# AI 服務商配置（主: Agnes / 輔: Gemini）
# ============================================
AI_PROVIDER=agnes
LLM_API_KEY=
LLM_BASE_URL=https://apihub.agnes-ai.com/v1
LLM_MODEL=agnes-2.5-flash
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_TOKENS=2048
GEMINI_TIMEOUT=60
